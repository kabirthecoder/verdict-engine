# LLM: any OpenAI-compatible endpoint. Defaults target a local Ollama server.
# Ollama (free, local):  ollama pull qwen3:8b
VERDICT_LLM_BASE_URL=http://localhost:11434/v1
VERDICT_LLM_API_KEY=ollama
VERDICT_LLM_MODEL=qwen3:8b

# Groq free tier (hosted, fast, supports tool calling):
# VERDICT_LLM_BASE_URL=https://api.groq.com/openai/v1
# VERDICT_LLM_API_KEY=gsk_...
# VERDICT_LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter free models:
# VERDICT_LLM_BASE_URL=https://openrouter.ai/api/v1
# VERDICT_LLM_API_KEY=sk-or-...
# VERDICT_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Storage: sqlite for trial, postgres for real deployments.
VERDICT_DATABASE_URL=sqlite:///verdict.db

# Optional: raises GitHub API limits for the supply-chain domain.
GITHUB_TOKEN=
